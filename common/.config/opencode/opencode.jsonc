{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mare_browser_mcp": {
      "type": "local",
      "command": [
        "mare-browser-mcp"
      ],
      "environment": {
        "HEADLESS": "true"
      },
    },
    "agent-native-localhost": {
      "type": "remote",
      "url": "http://localhost:8080/mcp",
      "enabled": true
    },
    "anythingllm": {
      "type": "local",
      "command": [
        "anythingllm-mcp-server"
      ],
      "environment": {
        "ANYTHINGLLM_BASE_URL": "http://localhost:3001/api",
        "ANYTHINGLLM_API_KEY": "sk-anythingllm-local-dev",
        "ANYTHINGLLM_WORKSPACE": "local-rag"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  },
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk-7a132dd03fdeaea5-15670e-c5c89d58"
      },
      "models": {
        "opencode-zen/deepseek-v4-flash-free": {
          "name": "opencode-zen/deepseek-v4-flash-free"
        },
        "opencode-zen/minimax-m2.5-free": {
          "name": "opencode-zen/minimax-m2.5-free"
        },
        "opencode-zen/nemotron-3-super-free": {
          "name": "opencode-zen/nemotron-3-super-free"
        },
        "opencode-zen/qwen3.6-plus-free": {
          "name": "opencode-zen/qwen3.6-plus-free"
        },
        "opencode-zen/big-pickle": {
          "name": "opencode-zen/big-pickle"
        },
        "opencode-go/deepseek-v4-pro-high": {
          "name": "opencode-go/deepseek-v4-pro-high"
        }
      }
    },
    "local-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local AI (llama-swap)",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "sk-local-dummy-key-change-me"
      },
      "models": {
        "qwen2.5-coder-7b-instruct": {
          "name": "Qwen2.5 Coder 7B Instruct"
        },
        "qwen2.5-7b-instruct": {
          "name": "Qwen2.5 7B Instruct (router:8085)"
        },
        "nomic-embed-text": {
          "name": "Nomic Embed Text v1.5"
        }
      }
    }
  }
}
